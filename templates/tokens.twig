{% extends "layout.twig" %}
{% set title = "API Tokens" %}
{% block content %}
<div class="card bg-base-100 shadow-xl rounded-2xl w-full">
    <div class="card-body p-6 md:p-10">
        
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h2 class="card-title text-primary text-3xl">🔑 API Tokens</h2>
                <p class="text-base-content/70 mt-1">
                    Use um token para autenticar chamadas à API sem precisar de sessão/cookie.
                </p>
            </div>
        </div>

        {% if flash_success %}
            <div class="alert alert-success mb-6"><span>{{ flash_success }}</span></div>
        {% endif %}
        {% if flash_error %}
            <div class="alert alert-error mb-6"><span>{{ flash_error }}</span></div>
        {% endif %}

        {% if flash_token %}
            <div class="alert alert-warning mb-8 shadow-lg">
                <div class="w-full">
                    <h3 class="font-bold text-lg mb-2">⚠️ Copie seu token agora — não será mostrado novamente</h3>
                    <div class="flex flex-col md:flex-row gap-2 mt-2">
                        <pre class="p-4 bg-base-300 rounded text-sm overflow-x-auto flex-1 select-all font-mono">{{ flash_token }}</pre>
                        <button type="button" onclick="navigator.clipboard.writeText('{{ flash_token }}'); this.textContent='✅ Copiado!'" class="btn btn-primary md:w-32">📋 Copiar</button>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Formulário de Criação -->
        <form method="post" action="?action=token_create" class="bg-base-200 p-6 rounded-xl mb-8 flex flex-col md:flex-row gap-4 items-end">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <div class="form-control flex-1 w-full">
                <label class="label"><span class="label-text font-bold">Nome do token</span></label>
                <input type="text" name="name" required maxlength="100" placeholder="Ex: Integração Zapier, App Mobile, Script Backup" class="input input-bordered w-full">
            </div>
            <button type="submit" class="btn btn-primary w-full md:w-auto">+ Gerar Token</button>
        </form>

        <!-- Tabela de Tokens -->
        <div class="overflow-x-auto bg-base-100 rounded-lg border border-base-300">
            <table class="table table-zebra w-full">
                <thead>
                    <tr class="bg-base-200 text-base-content">
                        <th class="w-16">#</th>
                        <th>Nome</th>
                        <th>Prefixo</th>
                        <th>Último uso</th>
                        <th>Criado em</th>
                        <th>Status</th>
                        <th class="text-right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in tokens %}
                        <tr class="hover">
                            <td class="text-sm text-base-content/60">{{ t.id }}</td>
                            <td class="font-medium">{{ t.name }}</td>
                            <td><code class="text-xs bg-base-200 px-2 py-1 rounded">{{ t.token_prefix }}…</code></td>
                            <td class="text-sm">{{ t.last_used_at ?? '—' }}</td>
                            <td class="text-sm">{{ t.created_at }}</td>
                            <td>
                                {% if t.revoked_at %}
                                    <span class="badge badge-error badge-sm text-white">Revogado</span>
                                {% else %}
                                    <span class="badge badge-success badge-sm text-white">Ativo</span>
                                {% endif %}
                            </td>
                            <td class="text-right">
                                {% if not t.revoked_at %}
                                    <a href="?action=token_revoke&id={{ t.id }}" onclick="return confirm('Revogar este token? Ele deixará de funcionar imediatamente.')" class="btn btn-sm btn-error text-white">Revogar</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-10 text-base-content/50">
                                Nenhum token criado ainda. Gere o primeiro acima.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="divider my-8">Como usar</div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Exemplo cURL -->
            <div class="bg-base-200 p-6 rounded-xl">
                <p class="mb-3 font-bold text-lg">Exemplo com curl:</p>
                <pre class="bg-base-300 p-4 rounded text-sm overflow-x-auto text-base-content">curl -H "Authorization: Bearer SEU_TOKEN_AQUI" \
     "http://localhost:8000/?action=api&table=usuarios"</pre>
            </div>
            
            <!-- Exemplo PowerShell -->
            <div class="bg-base-200 p-6 rounded-xl">
                <p class="mb-3 font-bold text-lg">Exemplo com PowerShell:</p>
                <pre class="bg-base-300 p-4 rounded text-sm overflow-x-auto text-base-content">$h = @{ Authorization = "Bearer SEU_TOKEN_AQUI" }
Invoke-RestMethod -Uri "http://localhost:8000/?action=api&table=usuarios" -Headers $h</pre>
            </div>
        </div>

    </div>
</div>
{% endblock %}