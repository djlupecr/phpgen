{% extends "layout.twig" %}
{% block content %}
<div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-4">🏢 Gerenciar Tenants</h1>
    <div class="card bg-base-100 shadow-xl p-6">
        <form method="post" action="?action=tenant_switch">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <div class="form-control">
                <label class="label"><span class="label-text">Tenant Ativo</span></label>
                <select name="tenant_id" class="select select-bordered">
                    {% for t in tenants %}
                        <option value="{{ t.id }}" {% if t.id == session.tenant_id|default(1) %}selected{% endif %}>
                            {{ t.name }} ({{ t.slug }})
                        </option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="btn btn-primary mt-4">Trocar Tenant</button>
        </form>
    </div>
</div>
{% endblock %}